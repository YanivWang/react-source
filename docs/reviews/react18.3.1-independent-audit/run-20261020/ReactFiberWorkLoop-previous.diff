+  }
+  if ((fiber.subtreeFlags & StoreConsistency) !== NoFlags) {
+    let child = fiber.child;
+    while (child !== null) {
+      if (!isRenderConsistentWithExternalStores(child)) return false;
+      child = child.sibling;
+    }
+  }
+  return true;
