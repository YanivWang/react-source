{
  "name": "react-source",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "vite --config scripts/vite/vite.config.mts",
    "lint": "turbo run lint",
    "lint:fix": "eslint packages --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/rollup/build.js",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && node --test --test-concurrency=1 scripts/tests/core.test.cjs scripts/tests/regression.test.cjs",
    "test:core": "pnpm run build && node --test scripts/tests/core.test.cjs",
    "test:regression": "pnpm run build && node --test scripts/tests/regression.test.cjs",
    "test:browser:build": "pnpm run build && node scripts/tests/browser/build.cjs",
    "test:browser:serve": "node scripts/tests/browser/serve.cjs",
    "test:browser:compare": "node scripts/tests/browser/compare.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --cache-location node_modules/.cache/eslint/ --fix",
    "*.{ts,tsx,md,json,yml,yaml}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1",
    "tslib": "^2.8.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-react": "^6.1.0",
    "vite": "^8.2.2",
    "jsdom": "20.0.3",
    "react-reference": "npm:react@18.3.1",
    "react-dom-reference": "npm:react-dom@18.3.1"
  }
}
